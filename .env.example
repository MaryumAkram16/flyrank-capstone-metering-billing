# Database
DATABASE_URL=sqlite:///./billing.db

# FakeStripe webhook signing secret (see app/fake_stripe.py — Stripe itself isn't
# usable from Pakistan, so this stands in for Stripe's whsec_ signing secret).
# Any value works locally as long as it matches on both sides; change it here
# and the app picks it up automatically. If swapping in real Stripe later,
# this becomes the actual whsec_ secret from the Stripe Dashboard.
STRIPE_WEBHOOK_SECRET=whsec_fake_test_secret_change_me

# App
APP_ENV=development
